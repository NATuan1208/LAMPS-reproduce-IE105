# Required: your fine-tuned CodeBERT model id on Hugging Face
CODEBERT_MODEL_ID=your-username/your-codebert-model

# Optional for private/gated Hugging Face models
HF_TOKEN=

# Device for CodeBERT inference: auto | cpu | cuda | mps
CODEBERT_DEVICE=auto

# Reasoning model profile and credentials
LAMPS_REASONING_PROVIDER_PROFILE=auto
LAMPS_REASONING_MODEL=openai/gpt-4o-mini
LAMPS_REASONING_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LAMPS_REASONING_BASE_URL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Deterministic policy controls
LAMPS_EMPTY_SELECTION_POLICY=MALICIOUS
LAMPS_CLASSIFICATION_RETRIES=1
LAMPS_EVALUATION_MODE=D1
LAMPS_EXTRACT_MODE=
LAMPS_ENABLE_REASONING_JUSTIFICATION=false

# Directories
LAMPS_DOWNLOAD_DIR=artifacts/pypi_downloads
LAMPS_EXTRACT_DIR=artifacts/extracted
LAMPS_ALLOWED_READ_ROOT=.
LAMPS_OUTPUT_DIR=outputs

# Safety limits
LAMPS_MAX_FILE_BYTES=2097152
PIP_DOWNLOAD_TIMEOUT=180
